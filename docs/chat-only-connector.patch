+export function classifyComposerMode({chatPressed=false,workPressed=false,label='',hasToggle=false}) {
+  if(hasToggle){if(chatPressed&&!workPressed)return 'chat';if(workPressed&&!chatPressed)return 'work';return 'unknown';}
+  if(/\bwork\s+with\s+chatgpt\b/i.test(label))return 'work';
+  if(/^(ask chatgpt|message chatgpt|hỏi chatgpt|nhắn tin cho chatgpt)$/i.test(label.trim()))return 'chat';
+  return 'unknown';
+}
+export function composerMode(doc=document) {
+  const group=[...doc.querySelectorAll('[role="group"][aria-label="Composer mode"]')].find(visible);
+  const buttons=group?[...group.querySelectorAll('button')].filter(visible):[];
+  const chat=buttons.find(n=>n.textContent.trim()==='Chat'),work=buttons.find(n=>n.textContent.trim()==='Work');
+  const input=composer(doc);
+  const label=input?.getAttribute('aria-label')||input?.getAttribute('placeholder')||input?.querySelector('[data-placeholder]')?.getAttribute('data-placeholder')||'';
+  return {mode:classifyComposerMode({hasToggle:!!group,chatPressed:chat?.getAttribute('aria-pressed')==='true',workPressed:work?.getAttribute('aria-pressed')==='true',label}),chat,input};
+}
